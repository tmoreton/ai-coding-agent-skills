{
  "expo": {
    "name": "{{displayName}}",
    "slug": "{{projectName}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "{{bundleIdentifier}}"
    },
    "android": {
      "package": "{{bundleIdentifier}}",
      "adaptiveIcon": {
        "backgroundColor": "#F2F0E8"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": []
  }
}
