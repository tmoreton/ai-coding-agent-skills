---
import "../styles/global.css";

const features = [
  {
    number: "01",
    title: "One operating view",
    body: "Bring launches, risks, and owner updates into one calm workspace."
  },
  {
    number: "02",
    title: "Signals, not noise",
    body: "Turn scattered project activity into decisions your team can act on."
  },
  {
    number: "03",
    title: "Momentum by default",
    body: "Keep every handoff visible without adding another status meeting."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Northstar is the operating system for focused product teams."
    />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <title>Northstar | Move with clarity</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#" aria-label="Northstar home">
        <span class="brand-mark">N</span>
        <span>Northstar</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#platform">Platform</a>
        <a href="#approach">Approach</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="header-cta" href="mailto:hello@example.com">Book a demo</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Product operations, re-centered</p>
          <h1 id="hero-title">Move with clarity.</h1>
          <p class="hero-intro">
            Northstar gives ambitious product teams one place to see the work,
            resolve risk, and keep momentum.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="mailto:hello@example.com">Start a conversation</a>
            <a class="text-link" href="#platform">Explore the platform <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="product-view" aria-label="Northstar product overview">
          <div class="product-topbar">
            <div>
              <span class="status-dot"></span>
              Launch command
            </div>
            <span>Week 32</span>
          </div>
          <div class="product-grid">
            <div class="signal-panel">
              <p>Momentum</p>
              <strong>87%</strong>
              <div class="signal-chart" aria-hidden="true">
                <span style="height: 28%"></span>
                <span style="height: 42%"></span>
                <span style="height: 38%"></span>
                <span style="height: 64%"></span>
                <span style="height: 58%"></span>
                <span style="height: 82%"></span>
                <span style="height: 92%"></span>
              </div>
            </div>
            <div class="launch-panel">
              <div class="panel-heading">
                <p>Active launches</p>
                <span>3 on track</span>
              </div>
              <div class="launch-row">
                <span class="launch-icon citrus">A</span>
                <div><strong>Atlas</strong><small>Public beta</small></div>
                <span class="progress">92%</span>
              </div>
              <div class="launch-row">
                <span class="launch-icon coral">S</span>
                <div><strong>Signal</strong><small>Partner rollout</small></div>
                <span class="progress">74%</span>
              </div>
              <div class="launch-row">
                <span class="launch-icon sky">O</span>
                <div><strong>Orbit</strong><small>Design validation</small></div>
                <span class="progress">61%</span>
              </div>
            </div>
            <div class="focus-panel">
              <p>Focus this week</p>
              <strong>Close the loop on launch readiness.</strong>
              <div class="avatar-row" aria-label="Four contributors">
                <span>AM</span><span>RK</span><span>JL</span><span>+8</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="feature-section" id="platform" aria-labelledby="platform-title">
        <div class="section-heading">
          <p class="eyebrow">Built for the real work</p>
          <h2 id="platform-title">Less reporting.<br />More forward motion.</h2>
        </div>
        <div class="feature-list">
          {features.map((feature) => (
            <article>
              <span>{feature.number}</span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="closing" id="approach">
        <p class="eyebrow">A clearer way to operate</p>
        <h2>Make the next move obvious.</h2>
        <a class="button light" id="contact" href="mailto:hello@example.com">hello@example.com</a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#"><span class="brand-mark">N</span><span>Northstar</span></a>
      <p>Built for teams with somewhere to go.</p>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>
