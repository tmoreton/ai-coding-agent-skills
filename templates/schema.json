{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmoreton/ai-coding-agent-skills/templates/schema.json",
  "title": "Coding Agent Project Template",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "description",
    "category",
    "variables",
    "files",
    "commands",
    "postCreatePrompt"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "default"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "description": { "type": "string" },
          "default": { "type": "string" },
          "pattern": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "destination"],
        "properties": {
          "source": { "type": "string" },
          "destination": { "type": "string" },
          "template": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "object",
      "required": ["setup", "dev", "verify"],
      "properties": {
        "setup": { "type": "string" },
        "dev": { "type": "string" },
        "verify": { "type": "string" },
        "deploy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "postCreatePrompt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
